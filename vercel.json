{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "redirects": [
    { "source": "/cmuse(/.*)?", "destination": "/CMuse$1", "permanent": false },
    { "source": "/CMUSE(/.*)?", "destination": "/CMuse$1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/CMuse", "destination": "https://studio-contenu-wine.vercel.app/CMuse" },
    { "source": "/CMuse/(.*)", "destination": "https://studio-contenu-wine.vercel.app/CMuse/$1" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{*.{html,jsx,js},assets/**,server/legal-defaults/**/*.html,server/**/*.sql}"
    }
  }
}
