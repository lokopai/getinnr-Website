{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/CMuse", "destination": "https://studio-contenu-wine.vercel.app/CMuse" },
    { "source": "/CMuse/:path*", "destination": "https://studio-contenu-wine.vercel.app/CMuse/:path*" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{*.{html,jsx,js},assets/**,server/legal-defaults/**/*.html,server/**/*.sql}"
    }
  }
}
